table TableMesures
	lineageTag: 018954bf-15f8-42b2-8824-8805bb45720c

	measure 'Total Emp' = COUNTROWS('HR Analytics Data')
		formatString: #,0
		lineageTag: 3a2eddd7-1d7f-4da6-bc38-b41ba295c289

	measure Male = CALCULATE(TableMesures[Total Emp],'HR Analytics Data'[Gender]="Male")
