{
  "name": "HR Dashboard Moderne",
  "dataColors": ["#22D3EE", "#A78BFA", "#FBBF24", "#34D399", "#F472B6", "#60A5FA", "#FB923C", "#94A3B8"],
  "background": "#121A2F",
  "foreground": "#E6ECFA",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#22D3EE",
  "center": "#A78BFA",
  "minimum": "#1E3A5F",
  "textClasses": {
    "callout": { "fontSize": 36, "fontFace": "Segoe UI Semibold", "color": "#E6ECFA" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#E6ECFA" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#9AA8C7" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#B6C2DE" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0B1020" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0B1020" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#121A2F" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#22304F" } }, "radius": 16 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E6ECFA" } }, "fontSize": 14, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "dropShadow": [{ "show": false }]
      },
      "categoryAxis": [{ "labelColor": { "solid": { "color": "#B6C2DE" } }, "fontSize": 11, "showAxisTitle": false, "lineColor": { "solid": { "color": "#22304F" } } }],
      "valueAxis": [{ "labelColor": { "solid": { "color": "#9AA8C7" } }, "fontSize": 11, "showAxisTitle": false, "gridlineColor": { "solid": { "color": "#22304F" } } }],
      "legend": [{ "labelColor": { "solid": { "color": "#B6C2DE" } }, "fontSize": 11, "position": "Bottom" }],
      "labels": [{ "color": { "solid": { "color": "#E6ECFA" } }, "fontSize": 11 }]
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#E6ECFA" } }, "fontSize": 36, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#9AA8C7" } }, "fontSize": 12 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#E6ECFA" } }, "background": { "solid": { "color": "#121A2F" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#B6C2DE" } }, "background": { "solid": { "color": "#121A2F" } }, "outline": "None" }]
      }
    },
    "barChart": {
      "*": {
        "general": [{ "responsive": true }],
        "categoryAxis": [{ "showAxisTitle": false }],
        "valueAxis": [{ "show": false }]
      }
    },
    "columnChart": {
      "*": {
        "valueAxis": [{ "show": false }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": true, "labelStyle": "Percent of total" }]
      }
    }
  }
}
